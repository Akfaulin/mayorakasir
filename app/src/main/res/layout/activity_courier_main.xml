<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/slate_50">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:elevation="2dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MAYORA KURIR"
                android:textColor="@color/primary_red"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/tvCourierName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bambang Kurir Mayora"
                android:textColor="@color/slate_900"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>


        <ImageButton
            android:id="@+id/btnReport"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_agenda"
            android:contentDescription="Laporan &amp; Riwayat" />

        <ImageButton
            android:id="@+id/btnLogout"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_lock_power_off"
            android:contentDescription="Logout" />
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Armada Info Card (1 Mobil Box Operasional) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_fleet_banner"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="ARMADA OPERASIONAL PENGANGKUTAN"
                            android:textColor="@color/slate_400"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓ Siap Angkut"
                            android:textColor="@color/emerald_500"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvFleetModel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Daihatsu Gran Max Box 1.5 DOHC"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvFleetPlate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AG 9421 PQR"
                            android:textColor="@color/white"
                            android:background="@drawable/bg_plate_badge"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvFleetCapacity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kapasitas: 1.500 kg · Mobil Box Operasional Multi-Drop"
                        android:textColor="@color/slate_300"
                        android:textSize="12sp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <!-- Tombol Laporan & Riwayat Kurir (PDF / Excel) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardReportBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="2dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/slate_200"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="14dp">

                        <ImageView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_stat_circle"
                            android:padding="9dp"
                            android:src="@android:drawable/ic_menu_agenda"
                            app:tint="@color/primary_red" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Laporan &amp; Riwayat Pengantaran"
                                android:textColor="@color/slate_900"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Lihat riwayat DO, apa saja yang diantar &amp; unduh PDF / Excel"
                                android:textColor="@color/slate_500"
                                android:textSize="11sp"
                                android:layout_marginTop="1dp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Buka ›"
                            android:textColor="@color/primary_red"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Summary Cards Grid (2x2) -->
                <!-- Summary Cards Row (3 Cards: Siap Diantar, Selesai, Kendala) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <!-- Siap Diantar (Gabungan Siap Diantar & Dalam Antaran) -->
                    <LinearLayout
                        android:id="@+id/cardFilterReady"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/bg_rounded_card"
                        android:padding="12dp"
                        android:layout_marginEnd="5dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🚚 Siap Diantar"
                            android:textColor="@color/blue_800"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCountReady"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/slate_900"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Selesai (POD) -->
                    <LinearLayout
                        android:id="@+id/cardFilterDelivered"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/bg_rounded_card"
                        android:padding="12dp"
                        android:layout_marginHorizontal="2dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✅ Selesai"
                            android:textColor="@color/emerald_600"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCountDelivered"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/slate_900"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Issues -->
                    <LinearLayout
                        android:id="@+id/cardFilterIssue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:background="@drawable/bg_rounded_card"
                        android:padding="12dp"
                        android:layout_marginStart="5dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚠️ Kendala"
                            android:textColor="@color/rose_800"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCountIssues"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/slate_900"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Hidden legacy card for safe view binding -->
                    <LinearLayout
                        android:id="@+id/cardFilterTransit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone">
                        <TextView
                            android:id="@+id/tvCountInTransit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Filter Chips Horizontal -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:id="@+id/layoutChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chipAll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Semua Tugas"
                            android:textColor="@color/white"
                            android:background="@drawable/bg_chip_selected"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="7dp"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/chipReady"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Siap Diantar"
                            android:textColor="@color/slate_700"
                            android:background="@drawable/bg_chip_unselected"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="7dp"
                            android:textSize="13sp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/chipTransit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Dalam Antaran"
                            android:textColor="@color/slate_700"
                            android:background="@drawable/bg_chip_unselected"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="7dp"
                            android:textSize="13sp"
                            android:layout_marginEnd="8dp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/chipDelivered"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Selesai (POD)"
                            android:textColor="@color/slate_700"
                            android:background="@drawable/bg_chip_unselected"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="7dp"
                            android:textSize="13sp"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/chipIssue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ada Kendala"
                            android:textColor="@color/slate_700"
                            android:background="@drawable/bg_chip_unselected"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="7dp"
                            android:textSize="13sp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Search Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Cari nomor resi / toko / alamat..."
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxCornerRadiusTopStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:endIconMode="clear_text"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionSearch"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Select All Bar for Ready to Pick Tasks -->
                <LinearLayout
                    android:id="@+id/layoutSelectAll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_rounded_card"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone">

                    <CheckBox
                        android:id="@+id/cbSelectAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="0dp" />

                    <TextView
                        android:id="@+id/tvSelectAllLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Pilih Semua Pesanan Siap Diantar"
                        android:textColor="@color/slate_800"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp" />

                    <TextView
                        android:id="@+id/tvSelectAllCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0/0"
                        android:textColor="@color/slate_500"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Tasks RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTasks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <!-- Empty State -->
                <LinearLayout
                    android:id="@+id/layoutEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="32dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚚"
                        android:textSize="44sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tidak ada tugas pengiriman"
                        android:textColor="@color/slate_700"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tarik ke bawah untuk memuat ulang data terbaru."
                        android:textColor="@color/slate_400"
                        android:textSize="13sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Floating Bottom Bulk Action Bar -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardBulkAction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardElevation="12dp"
        app:cardBackgroundColor="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvBulkSelectedCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 pesanan dipilih"
                    android:textColor="@color/slate_900"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnCancelSelection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hapus pilihan"
                    android:textColor="@color/primary_red"
                    android:textSize="12sp"
                    android:paddingVertical="2dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBulkPickup"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Mulai Antar"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                app:cornerRadius="8dp"
                app:backgroundTint="@color/primary_red" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>