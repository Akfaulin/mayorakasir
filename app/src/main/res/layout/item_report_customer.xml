<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Store Name & Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tvCustStoreName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Toko Berkah Jaya"
                android:textColor="@color/slate_900"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCustStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Terkirim (POD)"
                android:textColor="@color/emerald_800"
                android:background="@drawable/bg_badge_delivered"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Customer Owner & Phone -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tvCustOwner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="👤 Pemilik: Budi Reseller"
                android:textColor="@color/slate_700"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCallCustomer"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Hubungi"
                android:textSize="11sp"
                android:textAllCaps="false"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:textColor="@color/primary_red"
                android:paddingHorizontal="8dp" />
        </LinearLayout>

        <!-- Address -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 "
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvCustAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Jl. Dhoho No. 45, Kediri, Jawa Timur"
                android:textColor="@color/slate_600"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/slate_100"
            android:layout_marginVertical="6dp" />

        <!-- Order Counts & Muatan Breakdown -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvCustTotalOrders"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📋 2 Pesanan (#CALC-001, #CALC-002)"
                android:textColor="@color/slate_700"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCustTotalQty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="35 ctn"
                android:textColor="@color/primary_red"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Products Summary per Toko -->
        <TextView
            android:id="@+id/tvCustProductsSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Torabika Duo (20 ctn)\n• Beng Beng Reguler (15 ctn)"
            android:textColor="@color/slate_600"
            android:textSize="11.5sp"
            android:lineSpacingExtra="2dp"
            android:layout_marginTop="2dp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>

