<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Tanggal & Ringkasan Harian -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDailyFormattedDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Senin, 01 Nov 2026"
                    android:textColor="@color/slate_900"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDailySubStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3 Toko Tujuan · 8 Koli · 3 Pesanan"
                    android:textColor="@color/slate_500"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDailyBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RUTE AKTIF"
                android:textColor="@color/primary_red"
                android:background="@drawable/bg_stat_card"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/slate_100"
            android:layout_marginBottom="10dp" />

        <!-- Title: Kirim ke mana saja hari ini -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 TUJUAN PENGANTARAN (KIRIM KE MANA SAJA):"
            android:textColor="@color/slate_400"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:layout_marginBottom="8dp" />

        <!-- Container for dynamically added destination stops -->
        <LinearLayout
            android:id="@+id/layoutDestinationsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</androidx.cardview.widget.CardView>

