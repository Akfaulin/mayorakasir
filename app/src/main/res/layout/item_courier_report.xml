<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/slate_200"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Tracking Code & Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvOrderCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#ORD-MAY-001"
                    android:textColor="@color/slate_900"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/tvDateTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="11 Okt 2026, 14:30 WIB"
                    android:textColor="@color/slate_500"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Terkirim (POD)"
                android:textColor="@color/emerald_600"
                android:background="@drawable/bg_badge_emerald"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/slate_100"
            android:layout_marginBottom="10dp" />

        <!-- Store & Recipient Info -->
        <TextView
            android:id="@+id/tvStoreName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Toko Grosir Berkah Sejahtera"
            android:textColor="@color/slate_900"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="3dp" />

        <TextView
            android:id="@+id/tvRecipient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👤 Penerima: Bpk. H. Sugiono (08123456789)"
            android:textColor="@color/slate_700"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Jl. Raya Dhoho No. 88, Kota Kediri, Jawa Timur"
            android:textColor="@color/slate_500"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="12dp" />

        <!-- Muatan & Produk yang Diantar Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_stat_card"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="RINCIAN BARANG YANG DIANTAR:"
                    android:textColor="@color/primary_red"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/tvTotalQty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15 Karton (Ctn)"
                    android:textColor="@color/slate_900"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvItemsBreakdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Roma Kelapa 300g (10 ctn)\n• Kopiko Candy 150g (5 ctn)"
                android:textColor="@color/slate_800"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <!-- Issue Alert Banner (if any) -->
        <LinearLayout
            android:id="@+id/layoutIssueAlert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_badge_rose"
            android:padding="10dp"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvIssueText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚠️ Kendala: Toko tutup saat pengantaran"
                android:textColor="@color/rose_800"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- POD Verification Footer -->
        <LinearLayout
            android:id="@+id/layoutPodFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPodReceiver"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Diterima oleh: Bpk. Sugiono"
                    android:textColor="@color/emerald_600"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPodTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tanda tangan digital terverifikasi"
                    android:textColor="@color/slate_400"
                    android:textSize="10sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewPodDetail"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Lihat POD"
                android:textColor="@color/primary_red"
                android:textSize="11sp"
                app:strokeColor="@color/primary_red"
                app:cornerRadius="8dp" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
