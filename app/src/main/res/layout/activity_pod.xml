<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/podRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/slate_50">

    <!-- Header Bar (Pinned at top, outside ScrollView) -->
    <LinearLayout
        android:id="@+id/podHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:elevation="2dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Kembali"
            android:layout_marginEnd="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REKAM BUKTI PENGIRIMAN"
                android:textColor="@color/primary_red"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/tvOrderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#CALC-202609-001 · Toko Berkah"
                android:textColor="@color/slate_900"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable Content with Keyboard Insets -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/podScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="40dp">

            <!-- Selected Orders Summary Card (Bulk POD) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSelectedOrdersSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/blue_50">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvBulkSummaryHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📦 Serah Terima Sekaligus (3 Pesanan)"
                        android:textColor="@color/blue_800"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBulkOrdersList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="#CALC-001, #CALC-002"
                        android:textColor="@color/slate_700"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 1. PHOTO SECTION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Foto Bukti Serah Terima Fisik *"
                android:textColor="@color/slate_900"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ambil foto penerima bersama barang pesanan Mayora:"
                android:textColor="@color/slate_500"
                android:textSize="12sp"
                android:layout_marginBottom="10dp" />

            <!-- Two Photo Buttons: Camera & Gallery -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTakePhotoCamera"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="📸 Foto Langsung"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp"
                    app:backgroundTint="@color/primary_red"
                    android:textColor="@color/white"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChooseGallery"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="🖼️ Pilih Galeri"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    app:strokeColor="@color/slate_400"
                    android:textColor="@color/slate_800"
                    app:cornerRadius="10dp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <!-- Photo Preview Area -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardPhotoPreview"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="@color/slate_100">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/ivPhotoPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:contentDescription="Pratinjau Foto" />

                    <LinearLayout
                        android:id="@+id/layoutPhotoPlaceholder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_centerInParent="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📷"
                            android:textSize="36sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Belum ada foto yang diambil"
                            android:textColor="@color/slate_400"
                            android:textSize="13sp"
                            android:layout_marginTop="6dp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearPhoto"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="✕ Hapus Foto"
                        android:textAllCaps="false"
                        android:textSize="11sp"
                        app:backgroundTint="@color/slate_900"
                        android:textColor="@color/white"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        android:layout_margin="10dp"
                        android:visibility="gone" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- 2. SIGNATURE SECTION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Tanda Tangan Digital Penerima *"
                android:textColor="@color/slate_900"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Minta penerima menandatangani langsung pada area kotak putih:"
                android:textColor="@color/slate_500"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <com.example.mayoandorid.view.SignatureView
                android:id="@+id/signatureView"
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:background="@drawable/bg_signature_pad" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearSignature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bersihkan / Ulangi Tanda Tangan"
                android:textAllCaps="false"
                android:textSize="12sp"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:textColor="@color/slate_600"
                android:layout_gravity="end"
                android:layout_marginBottom="16dp" />

            <!-- 3. RECIPIENT & NOTES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. Identitas Penerima &amp; Catatan"
                android:textColor="@color/slate_900"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilRecipientName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nama Lengkap Penerima *"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRecipientName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionNext"
                    android:inputType="textPersonName" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Catatan Pengiriman (Opsional)"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_marginBottom="24dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:lines="2"
                    android:inputType="textMultiLine" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Submit Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitPod"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Kirim Bukti Pengiriman (Selesai)"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                app:backgroundTint="@color/emerald_600"
                android:textColor="@color/white" />

            <ProgressBar
                android:id="@+id/progressBarPod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>