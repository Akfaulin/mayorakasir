<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardTaskRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Line: Calculation Code & Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <CheckBox
                android:id="@+id/cbSelectOrder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvOrderCode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="#CALC-202609-001"
                android:textColor="@color/primary_red"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dalam Perjalanan"
                android:textColor="@color/blue_800"
                android:background="@color/blue_50"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Store Name -->
        <TextView
            android:id="@+id/tvStoreName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Toko Berkah Jaya Abadi"
            android:textColor="@color/slate_900"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <!-- Destination Address -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top"
            android:layout_marginTop="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 "
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Jl. Merdeka No. 45, RT 02/RW 04, Kediri"
                android:textColor="@color/slate_600"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Recipient & Phone -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/tvRecipient"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="👤 Budi Santoso (081234567890)"
                android:textColor="@color/slate_500"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCallPhone"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Hubungi"
                android:textAllCaps="false"
                android:textSize="11sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/slate_300"
                android:textColor="@color/slate_700" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/slate_100"
            android:layout_marginVertical="10dp" />

        <!-- Info Grid (Koli, Berat, Mobil) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Muatan"
                    android:textColor="@color/slate_400"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvPackageInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12 Koli · 45.5 kg"
                    android:textColor="@color/slate_800"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Armada Box"
                    android:textColor="@color/slate_400"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvFleetInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AG 9421 PQR"
                    android:textColor="@color/primary_red"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Issue Box (if reported) -->
        <LinearLayout
            android:id="@+id/layoutIssueAlert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/rose_50"
            android:padding="10dp"
            android:layout_marginTop="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvIssueText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚠️ Kendala: Toko tutup saat kurir tiba."
                android:textColor="@color/rose_800"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <!-- Action: Pickup dari Gudang -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickup"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="📦 Serah Terima dari Gudang"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                app:backgroundTint="@color/amber_500"
                android:textColor="@color/white"
                android:visibility="gone" />

            <!-- Action: Selesaikan POD -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitPod"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="📸 Rekam Bukti (POD)"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="8dp"
                app:backgroundTint="@color/emerald_600"
                android:textColor="@color/white"
                android:visibility="gone"
                android:layout_marginEnd="6dp" />

            <!-- Action: Lapor Kendala -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReportIssue"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:text="⚠️ Kendala"
                android:textAllCaps="false"
                android:textSize="12sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/rose_500"
                android:textColor="@color/rose_500"
                app:cornerRadius="8dp"
                android:visibility="gone" />

            <!-- Action: Lihat POD (Delivered) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewPod"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="🔍 Lihat Bukti POD Selesai"
                android:textAllCaps="false"
                android:textSize="13sp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/slate_300"
                android:textColor="@color/slate_700"
                app:cornerRadius="8dp"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>