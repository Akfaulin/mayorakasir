<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lapor Kendala Pengiriman"
        android:textColor="@color/slate_900"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pilih jenis kendala yang dihadapi di lapangan:"
        android:textColor="@color/slate_500"
        android:textSize="13sp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp" />

    <Spinner
        android:id="@+id/spIssueType"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_rounded_card"
        android:paddingHorizontal="10dp"
        android:layout_marginBottom="14dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilIssueNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Keterangan Rinci Kendala *"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_marginBottom="16dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etIssueNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lines="3"
            android:inputType="textMultiLine" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelIssue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Batal"
            android:textAllCaps="false"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="@color/slate_600"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitIssue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kirim Kendala"
            android:textAllCaps="false"
            app:backgroundTint="@color/rose_500"
            android:textColor="@color/white" />
    </LinearLayout>
</LinearLayout>